// Copiar este archivo como "secrets.h" (sin el .example) y completar los datos reales.
// El .gitignore de la raiz ya excluye secrets.h para que la API key no se suba a ningun repo.

#pragma once

#define WIFI_SSID     "TU_RED_WIFI"
#define WIFI_PASSWORD "TU_PASSWORD_WIFI"

// API key del proveedor. Nunca hardcodear esto en main.cpp.
#define LLM_API_KEY   "TU_API_KEY_ACA"

// Endpoints. Estos son los de OpenAI; si usan otro proveedor hay que ajustarlos.
// API_HOST y STT_API_PATH van separados porque la subida del audio se hace
// abriendo el socket a mano (ver voice.cpp), no con HTTPClient.
#define API_HOST      "api.openai.com"
#define LLM_API_URL   "https://api.openai.com/v1/chat/completions"
#define STT_API_PATH  "/v1/audio/transcriptions"
#define TTS_API_URL   "https://api.openai.com/v1/audio/speech"
